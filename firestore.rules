rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 관리자 체크 ───────────────────────────────────────────
    // 1차: 하드코딩 이메일 (기존 호환), 2차: DB role 필드 (향후 다중 관리자)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'peace@peace.re.kr' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── 보안 검증 함수들 ─────────────────────────────────────
    function isValidXpIncrement() {
      return !('totalXp' in request.resource.data) ||
             !('totalXp' in resource.data) ||
             (request.resource.data.totalXp - resource.data.totalXp) <= 8000;
    }

    function isValidGoldChange() {
      return !('gold' in request.resource.data) ||
             !('gold' in resource.data) ||
             ((request.resource.data.gold - resource.data.gold) <= 8000 &&
              (request.resource.data.gold - resource.data.gold) >= -5000);
    }

    // ─── 유저 데이터 ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && isValidXpIncrement() && isValidGoldChange()) || isAdmin();
      allow delete: if isAdmin();

      // ─── 독서 세션 ───────────────────────────────────────────
      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                         request.resource.data.elapsedTime is number &&
                         request.resource.data.elapsedTime <= 28800 &&
                         request.resource.data.elapsedTime >= 0 &&
                         request.resource.data.rewards.xp is number &&
                         request.resource.data.rewards.xp <= 30000 &&
                         request.resource.data.rewards.gold is number &&
                         request.resource.data.rewards.gold <= 30000;
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ─── 알림 (깃펜 리액션 등) ─────────────────────────────
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isLoggedIn();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ─── 공개 피드 ────────────────────────────────────────────────
    match /public_feed/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.elapsedTime is number &&
                       request.resource.data.elapsedTime <= 28800;
      // 본인: 자기 글 수정, 또는 신고(reports 필드 추가)만 허용
      allow update: if isLoggedIn() && (
                       resource.data.uid == request.auth.uid ||
                       isAdmin() ||
                       // 신고 또는 리액션만 추가 가능
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'reactions']))
                     );
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── 집계 통계 (stats 컬렉션) ───────────────────────────────
    // empire_totals, ranking_top50 등
    match /stats/{docId} {
      allow read: if isLoggedIn();
      // 로그인한 유저는 집계 문서 업데이트 가능 (increment 용)
      allow write: if isLoggedIn();
    }

    // ─── 시스템 설정 (관리자 전용 쓰기) ─────────────────────────
    match /system/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── 공지사항 (관리자 전용 쓰기, 읽기는 로그인 필수) ────────
    match /announcements/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
